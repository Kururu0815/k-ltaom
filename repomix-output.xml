          if (xx >= 0 && xx < x_axis_len && yy >= 0 && yy < y_axis_len) {
            if (xx != x || yy != y) {
              if (img_count[xx][yy] >= 0) {
                gradient += img_count[x][y] - img_count[xx][yy];
                cnt++;
              }
            }
          }
        }
      }
