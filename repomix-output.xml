void Preprocess::process(const sensor_msgs::PointCloud2::ConstPtr &msg, PointCloudXYZI::Ptr &pcl_out)
{
  switch (lidar_type)
  {
  case OUSTER:
    ouster_handler(msg);
    break;

  case VELO16:
    velodyne_handler(msg);
    break;

  case HESAI128:
    hesai128_handler(msg);
    break;

    // === 新增分支 ===
    case OUSTER_MULRAN:
      mulran_handler(msg);
      break;

     case OUSTER_GEODE:
      geode_handler(msg);
      break;
