        new pcl::PointCloud<pcl::PointXYZI>);
    for (std::size_t j = 0; j < lidar_data.size(); j += 4) {
      lidar_points.emplace_back(lidar_data[j], lidar_data[j + 1],
                                lidar_data[j + 2]);
