        opt_debug_file <<  "last_lc_prev_idx " << last_lc_prev_idx << ", lc_prev_idx " << lc_prev_idx << std::endl;
        opt_debug_file <<  "last_lc_curr_idx " << last_lc_curr_idx << ", lc_curr_idx " << lc_curr_idx << std::endl;

