          res_temp_SO3 = MTK::A_matrix(seg_SO3).transpose();
          for(int i = 0; i < n; i++){
            L_. template block<3, 1>(idx, i) = res_temp_SO3 * (P_. template block<3, 1>(idx, i));
          }
