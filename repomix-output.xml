        for(typename std::vector<std::pair<int, int> >::iterator it = x_.SO3_state.begin(); it != x_.SO3_state.end(); it++) {
          int idx = (*it).first;
          for(int i = 0; i < 3; i++){
            seg_SO3(i) = dx_(i + idx);
